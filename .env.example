# ==============================================================================
# POLITICAL MAYHEM: Battle for the Cities — AI & MCP Gateway Configuration
# Copy this file to .env and populate keys as needed. Never commit .env to Git.
# ==============================================================================

# Dual-Provider LLM selection: auto | ollama | gemini | openai | groq
# "auto" selects local Ollama when running, otherwise falls back to configured cloud API
LLM_PROVIDER=auto

# Local Ollama Provider (Privacy-preserving & offline-capable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Google Gemini API (Cloud Provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (Cloud Provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq API (Cloud Provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local AI Gateway HTTP Bridge (Unity <-> Agent Runtime / MCP Server)
AI_GATEWAY_HOST=127.0.0.1
AI_GATEWAY_PORT=8765

# RAG Retrieval Options
# Set to "true" to combine local Ollama embeddings (nomic-embed-text) with BM25+TF-IDF
USE_OLLAMA_EMBEDDINGS=false
